---
interface Props {
  subheading?: string;
}
const { subheading } = Astro.props;
---

{
  /* The page's H1, deliberately quiet: the countdown under it is what people came for. It
     never animates in: an entrance starting at opacity 0 once made
     Chrome measure the header logo as the LCP element instead of the heading. */
}
<header class="pb-4">
  <h1
    id="page-heading"
    class="text-2xl font-extrabold leading-tight tracking-tight text-ink sm:text-[1.65rem]"
  >
    <slot />
  </h1>
  {subheading && <p class="mt-1 max-w-3xl text-[0.95rem] text-ink-soft">{subheading}</p>}
</header>
