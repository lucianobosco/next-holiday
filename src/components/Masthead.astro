---
interface Props {
  eyebrow: string;
  subheading?: string;
}
const { eyebrow, subheading } = Astro.props;
---

<header class="text-center pb-4 sm:pb-6 animate-fade-up">
  <div class="mb-4 flex items-center justify-center gap-3 text-ink-soft">
    <span class="h-px w-10 bg-line"></span>
    <span class="text-[0.7rem] font-semibold uppercase tracking-[0.28em]">{eyebrow}</span>
    <span class="h-px w-10 bg-line"></span>
  </div>
  <h1
    id="page-heading"
    tabindex="-1"
    class="font-display text-4xl font-semibold leading-tight tracking-tight text-ink sm:text-5xl"
  >
    <slot />
  </h1>
  {
    subheading && (
      <p class="mx-auto mt-2 max-w-2xl text-base text-ink-soft sm:text-lg">{subheading}</p>
    )
  }
</header>
