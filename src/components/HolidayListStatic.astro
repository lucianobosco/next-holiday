---
import HolidayCard from "./HolidayCard.astro";
import type { Holiday } from "../lib/types/holiday";
interface Props {
  holidays: Holiday[];
  today: string;
  nextKey?: string | null;
  activeKey?: string | null;
  limit?: number;
  max?: number;
}
// `limit` is how many show before the "ver más" fold; `max` is how many exist at all.
// The holiday pages set `max` because all 32 of them were rendering the same national
// list -- byte-identical across every one of them -- which is duplicate content and 12 KB
// of HTML per page that says nothing specific to the holiday being described.
const { holidays, today, nextKey, activeKey, limit = 7, max } = Astro.props;
const all = max ? holidays.slice(0, max) : holidays;
const visible = all.slice(0, limit);
const rest = all.slice(limit);
---

<ul>
  {visible.map((h) => <HolidayCard h={h} today={today} nextKey={nextKey} activeKey={activeKey} />)}
</ul>
{
  rest.length > 0 && (
    <details class="group mt-3 open:mt-0" data-fold>
      {/* The summary opens the rest and then gets out of the way: "Ver menos" belongs where
          the list ends, not above the holidays it would hide. */}
      <summary class="flex min-h-11 w-full cursor-pointer items-center justify-center rounded-md bg-paper-deep px-4 py-2.5 text-sm font-bold text-ink transition-colors hover:bg-accent-soft list-none group-open:hidden [&::-webkit-details-marker]:hidden">
        Ver {rest.length} festivo{rest.length === 1 ? "" : "s"} más
      </summary>
      <ul>
        {rest.map((h) => (
          <HolidayCard h={h} today={today} nextKey={nextKey} activeKey={activeKey} />
        ))}
      </ul>
      <button
        type="button"
        data-fold-close
        class="mt-3 flex min-h-11 w-full cursor-pointer items-center justify-center rounded-md bg-paper-deep px-4 py-2.5 text-sm font-bold text-ink transition-colors hover:bg-accent-soft"
      >
        Ver menos
      </button>
    </details>
  )
}
<script>
  import { dayCount, todayInMadrid } from "../lib/utils/holidays";

  function updDays() {
    document.querySelectorAll("[data-festdate]").forEach((el) => {
      const ds = el.getAttribute("data-festdate");
      if (!ds) return;
      // The same count the server rendered, recomputed in case the page sat open past midnight.
      const c = dayCount(ds, todayInMadrid(), Date.now());
      const n = el.querySelector("[data-days-num]");
      const u = el.querySelector("[data-days-unit]");
      if (n) n.textContent = c.num;
      if (u) u.textContent = c.unit;
    });
  }
  updDays();

  // "Ver menos" sits at the end of the list: close it and bring the toggle back into view,
  // or the visitor is left far below the list that just collapsed.
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest("[data-fold-close]");
    const fold = btn?.closest<HTMLDetailsElement>("details[data-fold]");
    if (!fold) return;
    fold.open = false;
    const summary = fold.querySelector("summary");
    summary?.focus({ preventScroll: true });
    summary?.scrollIntoView({ block: "center" });
  });
</script>
