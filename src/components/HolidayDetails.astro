---
import { getCustoms } from "../lib/utils/holidayCustoms";
import { getPracticalInfo } from "../lib/utils/practical";
import { isNational, isLocal } from "../lib/utils/holidays";
import { getCommunityName } from "../lib/utils/communities";
import type { Holiday } from "../lib/types/holiday";

interface Props {
  holiday: Holiday;
  comoSeViveHeading: string;
  practicalHeading: string;
}
const { holiday, comoSeViveHeading, practicalHeading } = Astro.props;
const customs = getCustoms(holiday);
const practical = getPracticalInfo(holiday);
const twoUp = Boolean(customs);
const scope = isLocal(holiday)
  ? `Festivo local · ${holiday.locality}`
  : isNational(holiday)
    ? "Festivo nacional"
    : (holiday.counties ?? []).map(getCommunityName).join(", ");

const GLYPHS: Record<string, string> = {
  place:
    '<path d="M12 21s7-6.6 7-11a7 7 0 1 0-14 0c0 4.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.4"/>',
  closed:
    '<rect x="4.5" y="10.5" width="15" height="9.5" rx="1.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>',
  open: '<path d="M4 9.5 5.2 5h13.6L20 9.5"/><path d="M4 9.5h16v9.5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9.5z"/><path d="M9 13.5h6"/>',
  transport:
    '<rect x="5" y="4" width="14" height="13" rx="2"/><path d="M5 12h14"/><path d="M7.5 17.5 6.5 20M16.5 17.5 17.5 20"/>',
};
---

<section class="mt-12 animate-fade-up" aria-label="Sobre este festivo">
  <div
    class={`overflow-hidden rounded-2xl border border-line bg-paper-card shadow-sm ${twoUp ? "" : "lg:max-w-2xl"}`}
  >
    <div class={twoUp ? "grid divide-y divide-line lg:grid-cols-2 lg:divide-x lg:divide-y-0" : ""}>
      {
        customs && (
          <div class="p-6 sm:p-7">
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-ink-soft">
              Tradiciones
            </p>
            <h2 class="mt-1.5 font-display text-2xl font-semibold leading-tight text-ink">
              {comoSeViveHeading}
            </h2>
            <ul class="mt-5 flex flex-col gap-4">
              {customs.map((c) => (
                <li class="flex gap-3.5">
                  <span
                    aria-hidden="true"
                    class="mt-[0.45rem] h-2 w-2 shrink-0 rotate-45 rounded-[1px] bg-terracotta"
                  />
                  <p class="text-[0.95rem] leading-relaxed text-ink">{c}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="p-6 sm:p-7">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-ink-soft">
          Información práctica
        </p>
        <h2 class="mt-1.5 font-display text-2xl font-semibold leading-tight text-ink">
          {practicalHeading}
        </h2>
        <div class="mt-2.5">
          <span
            class="inline-flex items-center rounded bg-paper-deep px-2.5 py-0.5 text-xs font-medium text-ink-soft"
            >{scope}</span
          >
        </div>
        <p class="mt-3.5 text-[0.95rem] leading-relaxed text-ink">{practical.scopeLine}</p>
        <dl class="mt-4">
          {
            practical.facts.map((f) => (
              <div class="relative border-t border-line py-3 pl-10 first:border-t-0">
                <dt class="text-xs font-semibold uppercase tracking-wide text-ink-soft">
                  <span
                    aria-hidden="true"
                    class="absolute left-0 top-[0.875rem] flex h-7 w-7 items-center justify-center rounded-full bg-ochre-soft text-ochre-deep"
                  >
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={GLYPHS[f.icon]}
                    />
                  </span>
                  {f.label}
                </dt>
                <dd class="mt-0.5 text-sm leading-relaxed text-ink">{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-4 border-t border-line pt-3 text-xs text-ink-faint">
          La apertura del comercio puede variar según el municipio y la normativa de cada comunidad.
        </p>
      </div>
    </div>
  </div>
</section>
