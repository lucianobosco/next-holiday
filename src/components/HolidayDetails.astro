---
import { getCustoms } from "../lib/utils/holidayCustoms";
import { getPracticalInfo } from "../lib/utils/practical";
import { isNational, isLocal } from "../lib/utils/holidays";
import { getCommunityName } from "../lib/utils/communities";
import type { Holiday } from "../lib/types/holiday";

interface Props {
  holiday: Holiday;
  comoSeViveHeading: string;
  practicalHeading: string;
}
const { holiday, comoSeViveHeading, practicalHeading } = Astro.props;
const customs = getCustoms(holiday);
const practical = getPracticalInfo(holiday);
const twoUp = Boolean(customs);
const scope = isLocal(holiday)
  ? `Festivo local · ${holiday.locality}`
  : isNational(holiday)
    ? "Festivo nacional"
    : (holiday.counties ?? []).map(getCommunityName).join(", ");
---

<section class="mt-8" aria-label="Sobre este festivo">
  <div class={`rounded-xl border border-line bg-paper-card ${twoUp ? "" : "lg:max-w-2xl"}`}>
    <div class={twoUp ? "grid divide-y divide-line lg:grid-cols-2 lg:divide-x lg:divide-y-0" : ""}>
      {
        customs && (
          <div class="min-w-0 p-4 sm:p-5">
            <h2 class="text-lg font-extrabold leading-snug text-ink">{comoSeViveHeading}</h2>
            <ul class="mt-2.5 list-disc pl-5 marker:text-accent">
              {customs.map((c) => (
                <li class="mt-2 leading-relaxed text-ink">{c}</li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="min-w-0 p-4 sm:p-5">
        <h2 class="text-lg font-extrabold leading-snug text-ink">{practicalHeading}</h2>
        <div class="mt-2.5">
          <span
            class="inline-flex rounded-md bg-paper-deep px-2 py-0.5 text-xs font-bold text-ink-soft"
            >{scope}</span
          >
        </div>
        <p class="mt-2.5 leading-relaxed text-ink">{practical.scopeLine}</p>
        <dl class="mt-2.5">
          {
            practical.facts.map((f) => (
              <div class="border-t border-line py-2 sm:grid sm:grid-cols-[120px_minmax(0,1fr)] sm:gap-3">
                <dt class="text-sm font-bold text-ink-soft">{f.label}</dt>
                <dd class="mt-0.5 text-sm leading-relaxed text-ink sm:mt-0">{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-2 border-t border-line pt-2.5 text-xs text-ink-soft">
          La apertura del comercio puede variar según el municipio y la normativa de cada comunidad.
        </p>
      </div>
    </div>
  </div>
</section>
