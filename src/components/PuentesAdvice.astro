---
const { advice, daysOff } = Astro.props as { advice: string; daysOff: number | null };
---

<div class="mt-5 border-t border-cream/15 pt-5">
  <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-cream/75">
    Consejo para el puente
  </p>
  <p class="mt-2 text-[0.95rem] sm:text-base leading-relaxed text-cream/95">{advice}</p>
  {
    daysOff && (
      <p class="mt-3 flex items-baseline gap-2 text-cream/85">
        <span class="font-display text-3xl font-semibold leading-none text-cream">{daysOff}</span>
        <span class="text-sm">días libres seguidos</span>
      </p>
    )
  }
</div>
