---
import { getUpcomingLongWeekends } from "../lib/utils/longWeekends";
interface Props {
  today: string;
}
const { today } = Astro.props;
const top = getUpcomingLongWeekends(today)
  .filter((p) => p.daysOff)
  .slice(0, 3);
// Only a proper "Puente" takes the long-weekend tint; the other labels stay neutral.
const pillTone = (label: string) =>
  label === "Puente" ? "bg-accent-soft text-ink" : "bg-paper-deep text-ink-soft";
---

{
  top.length > 0 && (
    <section class="mt-8">
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h2 class="text-lg font-extrabold text-ink">Próximos puentes</h2>
        <a
          href="/puentes/"
          class="inline-flex min-h-11 items-center text-sm font-semibold text-accent underline-offset-4 transition-colors hover:text-accent-deep hover:underline sm:min-h-0"
        >
          Ver todos los puentes
        </a>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        {top.map((p) => {
          const d = new Date(p.holiday.date + "T00:00:00");
          const day = d.getDate();
          const month = d.toLocaleDateString("es-ES", { month: "short" }).replace(".", "");
          return (
            <a
              href="/puentes/"
              class="block min-w-0 rounded-xl border border-line bg-paper-card p-4 no-underline transition-colors hover:border-accent"
            >
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-extrabold text-accent">
                  {day} {month}
                </span>
                <span class={`rounded-md px-2 py-0.5 text-xs font-bold ${pillTone(p.label)}`}>
                  {p.label}
                </span>
              </div>
              <p class="mt-1 font-semibold text-ink">{p.holiday.localName}</p>
              {p.daysOff && <p class="text-sm text-ink-soft">{p.daysOff} días libres</p>}
            </a>
          );
        })}
      </div>
    </section>
  )
}
