---
import Countdown from "./Countdown.tsx";
import BridgeWeek from "./BridgeWeek.astro";
import { bridgeHeadline, bridgeSentence, type LongWeekend } from "../lib/utils/longWeekends";

// The answer band: how long is left, to which holiday, and whether it makes a long
// weekend. The holiday's name stays an <h2> -- it is what the page is answering about --
// and the long-weekend verdict sits under it as an <h3>.
interface Props {
  targetDate: string;
  eyebrow: string;
  title: string;
  dateLine: string;
  badge: string;
  bridge?: LongWeekend | null;
  holidayDates?: string[];
}
const { targetDate, eyebrow, title, dateLine, badge, bridge, holidayDates = [] } = Astro.props;
---

<section class="rounded-xl border border-line bg-paper-card p-4 sm:p-6">
  {
    /* Mobile first: three stacked parts split by hairlines -- how long, to what, and the
      long weekend. From sm up they sit side by side and wrap. */
  }
  <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-9 sm:gap-y-5">
    <Countdown targetDate={targetDate} serverNow={Date.now()} client:load />

    <div class="min-w-0 sm:flex-1 sm:basis-56 border-t border-line pt-4 sm:border-0 sm:pt-0">
      <p class="text-sm font-semibold text-ink-soft">{eyebrow}</p>
      <h2 class="mt-0.5 text-lg font-extrabold sm:text-xl leading-tight tracking-tight text-ink">
        {title}
      </h2>
      <p class="mt-0.5 text-[0.95rem] text-ink">{dateLine}</p>
      {
        badge && (
          <span class="mt-2 inline-block rounded-md bg-paper-deep px-2 py-0.5 text-xs font-bold text-ink-soft">
            {badge}
          </span>
        )
      }
    </div>

    {
      bridge && (
        <>
          <span class="hidden w-px self-stretch bg-line lg:block" aria-hidden="true" />
          <div class="min-w-0 sm:flex-1 sm:basis-80 border-t border-line pt-4 sm:border-0 sm:pt-0">
            <h3 class="text-base font-extrabold sm:text-[1.05rem] leading-snug text-ink">
              {bridgeHeadline(bridge)}
            </h3>
            <p class="mt-1 text-sm text-ink-soft">{bridgeSentence(bridge)}</p>
            <BridgeWeek lw={bridge} holidayDates={holidayDates} />
          </div>
        </>
      )
    }
  </div>
  <slot />
</section>
