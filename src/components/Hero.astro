---
import Countdown from "./Countdown.tsx";

interface Props {
  targetDate: string;
  eyebrow: string;
  title: string;
  dateLine: string;
  badge: string;
}
const { targetDate, eyebrow, title, dateLine, badge } = Astro.props;
const titleSize =
  title.length <= 17
    ? "text-4xl sm:text-5xl"
    : title.length <= 30
      ? "text-3xl sm:text-4xl"
      : "text-2xl sm:text-3xl";
---

<section
  class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-terracotta via-[#b33f24] to-[#8f2f1a] shadow-[0_30px_70px_-28px_rgba(143,47,26,0.7)]"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(620px_300px_at_85%_-15%,rgba(255,221,150,0.32),transparent_62%)]"
  >
  </div>
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cream/30 to-transparent"
  >
  </div>

  <div class="relative z-10 p-7 sm:p-9">
    <div class="grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-center">
      <div class="min-w-0">
        <div class="flex items-center gap-2 text-cream/70">
          <svg width="15" height="15" viewBox="0 0 24 24" class="shrink-0" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
            <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="12" y1="2.5" x2="12" y2="5"></line><line x1="12" y1="19" x2="12" y2="21.5"
              ></line><line x1="2.5" y1="12" x2="5" y2="12"></line><line
                x1="19"
                y1="12"
                x2="21.5"
                y2="12"></line><line x1="5.2" y1="5.2" x2="7" y2="7"></line><line
                x1="17"
                y1="17"
                x2="18.8"
                y2="18.8"></line><line x1="18.8" y1="5.2" x2="17" y2="7"></line><line
                x1="7"
                y1="17"
                x2="5.2"
                y2="18.8"></line>
            </g>
          </svg>
          <span class="text-[0.7rem] font-semibold uppercase tracking-[0.24em]">{eyebrow}</span>
        </div>

        <h2
          class={`font-display mt-3 ${titleSize} font-semibold leading-[1.05] tracking-tight text-cream`}
        >
          {title}
        </h2>

        <div class="mt-3 flex flex-wrap items-center gap-2">
          <span class="text-sm sm:text-base text-cream/85">{dateLine}</span>
          <span
            class="inline-flex items-center rounded bg-cream/15 px-2.5 py-0.5 text-xs font-medium text-cream ring-1 ring-cream/25"
            >{badge}</span
          >
        </div>

        <slot />
      </div>

      <Countdown targetDate={targetDate} serverNow={Date.now()} client:load />
    </div>
  </div>
</section>
