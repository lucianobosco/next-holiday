---
import { isNational, daysUntil, holidayKey } from "../lib/utils/holidays";
import { getHolidayInfo } from "../lib/utils/holidayInfo";
import { getCommunityName } from "../lib/utils/communities";
import { holidaySlug, cityPath } from "../lib/utils/slug";
import type { Holiday } from "../lib/types/holiday";

interface Props {
  h: Holiday;
  today: string;
  nextKey?: string | null;
  activeKey?: string | null;
}
const { h, today, nextKey, activeKey } = Astro.props;
const key = holidayKey(h);
const isNext = key === nextKey;
const isActive = key === activeKey;
const d = new Date(h.date + "T00:00:00");
const day = d.getDate();
const month = d.toLocaleDateString("es-ES", { month: "short" }).replace(".", "").toUpperCase();
const yr = d.getFullYear();
const otherYear = yr !== Number(today.slice(0, 4));
const desc = getHolidayInfo(h)?.description;
const dd = daysUntil(h.date, today);
const scope = h.locality
  ? `${h.locality} · local`
  : isNational(h)
    ? "Nacional"
    : (h.counties ?? []).map(getCommunityName).join(", ");
const dest = h.locality ? cityPath(h.locality) : `/festivo/${holidaySlug(h.localName)}`;
const border = isActive
  ? "border-terracotta"
  : isNext
    ? "border-terracotta/60"
    : "border-line hover:border-terracotta/40";
---

<li>
  <a
    href={dest}
    class={`group flex items-start gap-4 rounded-xl border bg-paper-card px-3.5 py-3.5 shadow-sm transition hover:shadow-md ${border}`}
  >
    <div
      class={`flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-lg ${isNext ? "bg-terracotta text-cream" : "bg-paper-deep text-ink"}`}
    >
      <span class="font-display text-2xl font-semibold leading-none">{day}</span>
      <span
        class={`mt-0.5 text-[0.6rem] font-semibold tracking-wider ${isNext ? "text-cream" : "text-ink-soft"}`}
        >{month}{otherYear ? ` '${String(yr).slice(2)}` : ""}</span
      >
    </div>
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2">
        <p class="font-display text-base font-medium leading-snug text-ink">{h.localName}</p>
        {
          isNext && (
            <span class="shrink-0 rounded bg-terracotta px-1.5 py-0.5 text-[0.55rem] font-bold uppercase tracking-wider text-cream">
              Próximo
            </span>
          )
        }
      </div>
      {desc && <p class="mt-1 text-sm leading-relaxed text-ink-soft line-clamp-2">{desc}</p>}
      <p class="mt-1.5 text-xs text-ink-faint">{scope}</p>
    </div>
    <div class="shrink-0 text-right" data-festdate={h.date}>
      <span class="font-display text-xl font-semibold text-terracotta" data-days-num
        >{dd === 0 ? "hoy" : dd}</span
      >
      <p class="text-[0.65rem] uppercase tracking-wide text-ink-faint" data-days-unit>
        {dd === 0 ? "" : dd === 1 ? "día" : "días"}
      </p>
    </div>
  </a>
</li>
