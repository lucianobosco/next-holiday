---
import { COMMUNITIES } from "../lib/utils/communities";
import { CAPITAL_CITIES } from "../lib/utils/localHolidays";
import { communitySlug, cityPath } from "../lib/utils/slug";

interface Props {
  activeCommunity?: string;
  isPuentes?: boolean;
  isAllSpain?: boolean;
  isNational?: boolean;
  year: number;
}
const { activeCommunity, isPuentes, isAllSpain, isNational, year } = Astro.props;
---

<nav
  class="mt-4 rounded-xl border border-line bg-paper-card p-4 sm:p-5"
  aria-label="Explorar festivos por lugar"
>
  <div class="mb-5 flex flex-wrap gap-2">
    <a
      href={isPuentes ? "/" : "/puentes/"}
      class="inline-flex min-h-11 items-center rounded-md bg-accent px-4 py-2.5 text-sm font-bold text-white no-underline transition-colors hover:bg-accent-deep"
    >
      {isPuentes ? "Ver el próximo festivo" : `Puentes ${year} en España`}
    </a>
    {
      /* This component is rendered by all six page templates, so one anchor here is the
         whole site linking to /toda-espana/. It had none: its only route in was a Preact
         <select> navigated with window.location.assign, which a crawler never fires -- so
         the richest page on the site, and the only one whose title matches "festivos en
         España", was an orphan. */
    }
    {
      !isAllSpain && (
        <a
          href="/toda-espana/"
          class="inline-flex min-h-11 items-center rounded-md border border-line bg-paper-card px-4 py-2.5 text-sm font-bold text-ink no-underline transition-colors hover:border-accent hover:text-accent"
        >
          {`Todos los festivos de España ${year}`}
        </a>
      )
    }
    {
      /* Like /toda-espana/ above: one anchor here is every template linking to the page
         that answers "festivos nacionales". */
      !isNational && (
        <a
          href="/festivos-nacionales/"
          class="inline-flex min-h-11 items-center rounded-md border border-line bg-paper-card px-4 py-2.5 text-sm font-bold text-ink no-underline transition-colors hover:border-accent hover:text-accent"
        >
          {`Festivos nacionales ${year}`}
        </a>
      )
    }
  </div>

  <h2 class="text-lg font-extrabold text-ink">Festivos por comunidad</h2>
  <div class="mt-2 flex flex-wrap gap-1.5">
    {
      COMMUNITIES.map((c) => (
        <a
          href={`/comunidad/${communitySlug(c.code)}/`}
          class={`inline-flex min-h-11 items-center rounded-md border px-2.5 py-1.5 text-[13px] font-semibold no-underline transition-colors hover:border-accent hover:text-accent sm:min-h-0 ${c.code === activeCommunity ? "border-accent bg-accent-soft text-ink" : "border-line bg-paper-card text-ink"}`}
        >
          {c.name}
        </a>
      ))
    }
  </div>

  <h2 class="mt-5 text-lg font-extrabold text-ink">Festivos por ciudad</h2>
  <div class="mt-2 columns-2 gap-x-6 sm:columns-3 lg:columns-4">
    {
      CAPITAL_CITIES.map((c) => (
        <a
          href={cityPath(c.name)}
          class="block py-3 text-sm text-ink-soft no-underline transition-colors hover:text-accent hover:underline sm:py-1"
        >
          {c.name}
        </a>
      ))
    }
  </div>
</nav>
