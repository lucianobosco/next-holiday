---
import SiteSearch from "./SiteSearch.tsx";

// Mobile first: one row on every width. On a phone it is the brand, the link to the long
// weekends and a search button; "Toda España" stays in the HTML for crawlers and is the
// first option of the search. From sm up both links show and the search is a select.
const linkClass =
  "min-h-11 items-center whitespace-nowrap text-sm font-semibold text-ink no-underline underline-offset-4 transition-colors hover:text-accent hover:underline";
---

<header class="sticky top-0 z-40 border-b border-line bg-paper-card">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-1.5 sm:gap-5 sm:px-6">
    <a
      href="/"
      class="mr-auto flex min-h-11 shrink-0 items-center gap-2 text-base font-extrabold tracking-tight text-ink no-underline sm:text-[17px]"
      aria-label="El Próximo Festivo — inicio"
    >
      <svg class="size-6 shrink-0" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="7" fill="#1f4bd8"></rect>
        <g stroke="#fff" stroke-width="2.4" stroke-linecap="round">
          <path
            d="M16 3.5v4M16 24.5v4M3.5 16h4M24.5 16h4M7.4 7.4l2.8 2.8M21.8 21.8l2.8 2.8M24.6 7.4l-2.8 2.8M10.2 21.8l-2.8 2.8"
          ></path>
        </g>
        <circle cx="16" cy="16" r="5.4" fill="#fff"></circle>
      </svg>
      El Próximo Festivo
    </a>
    <nav aria-label="Principal" class="flex items-center gap-5">
      <a href="/puentes/" class:list={[linkClass, "inline-flex"]}>Puentes</a>
      <a href="/toda-espana/" class:list={[linkClass, "hidden sm:inline-flex"]}>Toda España</a>
    </nav>
    <div class="shrink-0 sm:w-44 lg:w-56">
      <SiteSearch client:idle />
    </div>
  </div>
</header>
