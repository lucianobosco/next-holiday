---
import SiteSearch from "./SiteSearch.tsx";
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 sm:px-8">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 no-underline"
      aria-label="El Próximo Festivo — inicio"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        class="shrink-0 text-ochre"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="12" y1="2" x2="12" y2="5"></line><line x1="12" y1="19" x2="12" y2="22"
          ></line><line x1="2" y1="12" x2="5" y2="12"></line><line x1="19" y1="12" x2="22" y2="12"
          ></line><line x1="4.9" y1="4.9" x2="7" y2="7"></line><line
            x1="17"
            y1="17"
            x2="19.1"
            y2="19.1"></line><line x1="19.1" y1="4.9" x2="17" y2="7"></line><line
            x1="7"
            y1="17"
            x2="4.9"
            y2="19.1"></line>
        </g>
      </svg>
      <span class="font-display text-base font-semibold tracking-tight text-ink sm:text-lg"
        >El Próximo <span class="italic text-terracotta">Festivo</span></span
      >
    </a>
    <nav aria-label="Principal" class="flex min-w-0 flex-1 items-center justify-end gap-2 sm:gap-3">
      <a
        href="/puentes/"
        class="shrink-0 rounded-full px-2.5 py-1.5 text-sm font-semibold text-ink no-underline transition hover:bg-terracotta-soft hover:text-terracotta-deep sm:px-3"
        >Puentes</a
      >
      <span class="hidden h-5 w-px bg-line sm:block" aria-hidden="true"></span>
      <SiteSearch client:idle />
    </nav>
  </div>
</header>
