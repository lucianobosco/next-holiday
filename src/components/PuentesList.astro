---
import { getUpcomingLongWeekends } from "../lib/utils/longWeekends";
const { today, year } = Astro.props as { today: string; year: number };
const puentes = getUpcomingLongWeekends(today);
// Only a proper "Puente" takes the long-weekend tint; the other labels stay neutral.
const pillTone = (label: string) =>
  label === "Puente" ? "bg-accent-soft text-ink" : "bg-paper-deep text-ink-soft";
---

<ul class="divide-y divide-line border-y border-line">
  {
    puentes.map((p) => {
      const d = new Date(p.holiday.date + "T00:00:00");
      const day = d.getDate();
      const month = d.toLocaleDateString("es-ES", { month: "short" }).replace(".", "");
      const yr = d.getFullYear();
      return (
        <li class="flex items-start gap-3 px-4 py-3 sm:gap-4 sm:px-5">
          <div class="w-14 shrink-0 font-extrabold leading-tight text-accent">
            {day} {month}
            {yr !== year && <span class="block text-xs font-bold text-ink-soft">{yr}</span>}
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
              <h3 class="font-bold text-ink">{p.holiday.localName}</h3>
              <span class={`rounded-md px-2 py-0.5 text-xs font-bold ${pillTone(p.label)}`}>
                {p.label}
              </span>
            </div>
            <p class="text-xs capitalize text-ink-soft">{p.weekdayName}</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-soft">{p.advice}</p>
          </div>
          {p.daysOff && (
            <p class="shrink-0 text-right text-sm text-ink-soft">
              <span class="block text-lg font-extrabold leading-none text-ink">{p.daysOff}</span>
              días
            </p>
          )}
        </li>
      );
    })
  }
</ul>
