---
import { getUpcomingLongWeekends } from "../lib/utils/longWeekends";
const { today, year } = Astro.props as { today: string; year: number };
const puentes = getUpcomingLongWeekends(today);
const TONE: Record<string, string> = {
  Puente: "bg-terracotta-soft text-terracotta-deep",
  "Puente flexible": "bg-terracotta-soft text-terracotta-deep",
  "Finde largo": "bg-ochre-soft text-ochre-deep",
  "Cae en fin de semana": "bg-paper-deep text-ink-soft",
};
---

<ul class="flex flex-col gap-3">
  {
    puentes.map((p) => {
      const d = new Date(p.holiday.date + "T00:00:00");
      const day = d.getDate();
      const month = d
        .toLocaleDateString("es-ES", { month: "short" })
        .replace(".", "")
        .toUpperCase();
      const yr = d.getFullYear();
      return (
        <li class="flex items-start gap-4 rounded-xl border border-line bg-paper-card px-4 py-4 shadow-sm">
          <div class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-lg bg-paper-deep text-ink">
            <span class="font-display text-2xl font-semibold leading-none">{day}</span>
            <span class="mt-0.5 text-[0.6rem] font-semibold tracking-wider text-ink-soft">
              {month}
              {yr !== year ? ` '${String(yr).slice(2)}` : ""}
            </span>
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-display text-lg font-medium text-ink">{p.holiday.localName}</h3>
              <span class={`rounded px-2.5 py-0.5 text-[0.7rem] font-medium ${TONE[p.label]}`}>
                {p.label}
              </span>
            </div>
            <p class="mt-0.5 text-xs capitalize text-ink-faint">{p.weekdayName}</p>
            <p class="mt-1.5 text-sm text-ink-soft">{p.advice}</p>
          </div>
          {p.daysOff && (
            <div class="shrink-0 text-right">
              <span class="font-display text-2xl font-semibold text-terracotta">{p.daysOff}</span>
              <p class="text-[0.65rem] uppercase tracking-wide text-ink-faint">días</p>
            </div>
          )}
        </li>
      );
    })
  }
</ul>
