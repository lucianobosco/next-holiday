---
import { getHolidayInfo } from "../lib/utils/holidayInfo";
import type { Holiday } from "../lib/types/holiday";
const { holiday } = Astro.props as { holiday: Holiday };
const info = getHolidayInfo(holiday);
---

{
  info?.description && (
    <div class="mt-5 border-t border-line pt-4">
      <p class="text-sm font-bold text-ink-soft">Qué se conmemora</p>
      <p class="mt-1 text-[0.95rem] leading-relaxed text-ink">
        {info.description}{" "}
        {info.pageUrl && (
          <a
            href={info.pageUrl}
            target="_blank"
            rel="noreferrer"
            class="text-sm text-ink-soft underline underline-offset-2 hover:text-accent"
          >
            Saber más en Wikipedia
          </a>
        )}
      </p>
    </div>
  )
}
