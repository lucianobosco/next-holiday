---
interface Props {
  label?: string;
  heightClass?: string;
}
const { label = "Publicidad", heightClass = "h-44" } = Astro.props;
---

<div
  class={`mt-6 flex items-center justify-center rounded-2xl border border-dashed border-line/70 bg-paper-card/40 ${heightClass}`}
  aria-hidden="true"
>
  <span class="text-[0.6rem] font-medium uppercase tracking-[0.22em] text-ink-faint">{label}</span>
</div>
