---
import Layout from "../layouts/Layout.astro";

// Rendered on demand: the SSR routes call Astro.rewrite("/404") for a slug that does not
// exist, and the Worker needs this component available at runtime. Prerendered it would be
// a static asset, and the rewrite would fail.
export const prerender = false;
Astro.response.status = 404;
---

<Layout title="Página no encontrada — El Próximo Festivo" description="">
  <div
    class="flex min-h-[50vh] flex-col items-center justify-center rounded-xl border border-line bg-paper-card p-4 text-center sm:p-5"
  >
    <div class="text-5xl font-extrabold tabular-nums tracking-tight text-accent">404</div>
    <h1 id="page-heading" class="mt-2 text-xl font-extrabold text-ink sm:text-2xl">
      Esta página se tomó el día libre
    </h1>
    <p class="mt-1 max-w-md text-ink-soft">No encontramos lo que buscabas.</p>
    <a
      href="/"
      class="mt-5 inline-flex min-h-11 items-center rounded-md bg-ink px-4 py-2.5 text-sm font-bold text-white no-underline transition-colors hover:bg-accent-deep"
      >Volver al inicio</a
    >
  </div>
</Layout>
