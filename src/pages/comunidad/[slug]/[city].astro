---
import Layout from "../../../layouts/Layout.astro";
import Masthead from "../../../components/Masthead.astro";
import Hero from "../../../components/Hero.astro";
import HeroFooterInfo from "../../../components/HeroFooterInfo.astro";
import HolidayListStatic from "../../../components/HolidayListStatic.astro";
import HolidayDetails from "../../../components/HolidayDetails.astro";
import LocalFiestas from "../../../components/LocalFiestas.astro";
import Filter from "../../../components/Filter.tsx";
import Calendar from "../../../components/Calendar.tsx";
import GetYourGuideCity from "../../../components/GetYourGuideCity.tsx";
import GetYourGuideWidget from "../../../components/GetYourGuideWidget.tsx";
import NextLongWeekend from "../../../components/NextLongWeekend.astro";
import PuentesTeaser from "../../../components/PuentesTeaser.astro";
import Explore from "../../../components/Explore.astro";
import EmbedSnippet from "../../../components/EmbedSnippet.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { ALL_HOLIDAYS } from "../../../lib/utils/allHolidays";
import {
  getUpcomingHolidays,
  filterByScope,
  holidayKey,
  isNational,
  isLocal,
  formatDate,
  cap,
  todayInMadrid,
  edgeCacheSeconds,
} from "../../../lib/utils/holidays";
import { CITY_PREFIX } from "../../../lib/utils/localHolidays";
import { communitySlug, getCityBySlug, cityPath } from "../../../lib/utils/slug";
import { getCommunityName } from "../../../lib/utils/communities";
import { gygLocationId } from "../../../lib/utils/gygLocations";
import { cityJsonLd } from "../../../lib/seo";
import {
  getUpcomingLongWeekends,
  datesInScopeOf,
  heroBridge as bridgeFor,
  nationalHolidayDates,
  nextLongerWeekend,
} from "../../../lib/utils/longWeekends";

// Rendered on demand: the next holiday, from the date of the request.
export const prerender = false;

const { slug, city: citySlugParam } = Astro.params;
const city = getCityBySlug(citySlugParam!);
// A 404 when the city does not exist, or does exist but not in the community the URL
// claims -- otherwise /comunidad/madrid/pontevedra would happily render Pontevedra.
if (!city || communitySlug(city.communityCode) !== slug) return Astro.rewrite("/404");
const today = todayInMadrid();
const year = Number(today.slice(0, 4));
Astro.cache.set({ maxAge: edgeCacheSeconds() });
const sel = CITY_PREFIX + city.name;
const upcoming = getUpcomingHolidays(ALL_HOLIDAYS, sel, today);
const scoped = filterByScope(ALL_HOLIDAYS, sel);
// Running out of future data is not a missing page. See index.astro. It matters more here
// than anywhere: local-holidays.json runs out a year before holidays.json does, and the
// municipal fiestas below are this page's whole reason to exist.
const hero = upcoming[0] ?? null;
const nextKey = hero ? holidayKey(hero) : null;
const activeKey = nextKey;
const heroBadge = !hero
  ? ""
  : isLocal(hero)
    ? `Festivo local · ${hero.locality}`
    : isNational(hero)
      ? "Festivo nacional"
      : (hero.counties ?? []).map(getCommunityName).join(", ");
// The holidays of the hero's own scope: what makes its long weekend real.
const holidayDates = hero ? datesInScopeOf(hero, city.communityCode) : nationalHolidayDates();
const heroBridge = hero ? bridgeFor(hero, today, city.communityCode) : null;
// Without a hero (the data has run out) the block still offers the first long weekend left.
const nextBridge = hero
  ? nextLongerWeekend(today, hero, city.communityCode)
  : (getUpcomingLongWeekends(today).find((lw) => lw.span) ?? null);
// The title and the H1 below are pivoted onto the intent this page actually serves.
// "Festivos en {city}" was byte-identical to the community page's H1 wherever the two share
// a name -- Madrid, Murcia, Ceuta, Melilla -- and a near-subset of it everywhere else. The
// municipal fiestas are the thing only this page has.
---

<Layout
  title={`Fiestas locales de ${city.name} ${year} — Festivos del municipio`}
  description={`Fiestas locales de ${city.name} con fechas, más los festivos autonómicos y nacionales que se celebran en el municipio.`}
  jsonLd={cityJsonLd(city.name, city.communityCode, cityPath(city.name), hero)}
>
  <Masthead
    subheading={`Fiestas locales, autonómicas y nacionales en ${city.name}, con cuenta atrás al próximo`}
    >Fiestas locales de {city.name}</Masthead
  >

  <Filter value={sel} client:idle />

  {
    hero && (
      <div class="mt-4">
        <Hero
          targetDate={hero.date}
          eyebrow={hero.date === today ? "Hoy es festivo" : "Próximo festivo"}
          title={hero.localName}
          dateLine={cap(formatDate(hero.date))}
          badge={heroBadge}
          bridge={heroBridge}
          holidayDates={holidayDates}
        >
          <HeroFooterInfo holiday={hero} />
        </Hero>
      </div>
    )
  }

  <div class="mt-4 flex flex-col gap-4 lg:flex-row lg:items-stretch">
    <section class="min-w-0 rounded-xl border border-line bg-paper-card p-4 sm:p-5 lg:flex-[2]">
      <h2 class="mb-3 text-lg font-extrabold text-ink">
        {`Próximos días festivos en ${city.name} ${year}`}
      </h2>
      <HolidayListStatic
        holidays={upcoming}
        today={today}
        nextKey={nextKey}
        activeKey={activeKey}
      />
    </section>
    <div class="flex min-w-0 flex-col gap-4 lg:flex-1">
      <NextLongWeekend lw={nextBridge} holidayDates={nationalHolidayDates()} year={year} />
      <GetYourGuideCity locationId={gygLocationId(sel)} />
    </div>
  </div>

  <section class="mt-4 rounded-xl border border-line bg-paper-card p-4 sm:p-5">
    <h2 class="mb-3 text-lg font-extrabold text-ink">
      {`Calendario laboral de ${city.name} ${year}`}
    </h2>
    <Calendar
      festivos={scoped}
      activeDate={hero ? hero.date : today}
      activeKey={activeKey}
      today={today}
      client:visible
    />
  </section>

  <GetYourGuideWidget cityName={city.name} />

  {
    hero && (
      <HolidayDetails
        holiday={hero}
        comoSeViveHeading={`Cómo se vive ${hero.localName} en ${city.name}`}
        practicalHeading={`Qué tener en cuenta en ${city.name}`}
      />
    )
  }

  {/* heroKey so the fiesta already detailed in the hero above is not repeated here. */}
  <LocalFiestas cityName={city.name} heroKey={hero ? holidayKey(hero) : undefined} />

  <PuentesTeaser today={today} />
  <Explore activeCommunity={city.communityCode} year={year} />
  <EmbedSnippet />
  <SiteFooter year={year} />
</Layout>
