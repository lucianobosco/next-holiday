---
import Layout from "../../layouts/Layout.astro";
import Masthead from "../../components/Masthead.astro";
import Hero from "../../components/Hero.astro";
import HeroFooterInfo from "../../components/HeroFooterInfo.astro";
import HolidayListStatic from "../../components/HolidayListStatic.astro";
import HolidayDetails from "../../components/HolidayDetails.astro";
import Filter from "../../components/Filter.tsx";
import Calendar from "../../components/Calendar.tsx";
import GetYourGuideCity from "../../components/GetYourGuideCity.tsx";
import GetYourGuideWidget from "../../components/GetYourGuideWidget.tsx";
import NextLongWeekend from "../../components/NextLongWeekend.astro";
import PuentesTeaser from "../../components/PuentesTeaser.astro";
import Explore from "../../components/Explore.astro";
import EmbedSnippet from "../../components/EmbedSnippet.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { ALL_HOLIDAYS } from "../../lib/utils/allHolidays";
import {
  getUpcomingHolidays,
  filterByScope,
  holidayKey,
  isNational,
  isLocal,
  formatDate,
  cap,
  todayInMadrid,
  edgeCacheSeconds,
} from "../../lib/utils/holidays";
import { getCommunityBySlug } from "../../lib/utils/slug";
import { getCommunityName } from "../../lib/utils/communities";
import { gygLocationId } from "../../lib/utils/gygLocations";
import { communityJsonLd } from "../../lib/seo";
import {
  getUpcomingLongWeekends,
  datesInScopeOf,
  heroBridge as bridgeFor,
  nationalHolidayDates,
  nextLongerWeekend,
} from "../../lib/utils/longWeekends";

// Rendered on demand: the next holiday, from the date of the request.
export const prerender = false;

const { slug } = Astro.params;
const community = getCommunityBySlug(slug!);
// A slug nobody has is genuinely a missing page, and stays a 404.
if (!community) return Astro.rewrite("/404");
const today = todayInMadrid();
const year = Number(today.slice(0, 4));
Astro.cache.set({ maxAge: edgeCacheSeconds() });
const sel = community.code;
const upcoming = getUpcomingHolidays(ALL_HOLIDAYS, sel, today);
const scoped = filterByScope(ALL_HOLIDAYS, sel);
// Running out of future data is not a missing page. See index.astro.
const hero = upcoming[0] ?? null;
const nextKey = hero ? holidayKey(hero) : null;
const activeKey = nextKey;
const heroBadge = !hero
  ? ""
  : isLocal(hero)
    ? `Festivo local · ${hero.locality}`
    : isNational(hero)
      ? "Festivo nacional"
      : (hero.counties ?? []).map(getCommunityName).join(", ");
// The holidays of the hero's own scope: what makes its long weekend real.
const holidayDates = hero ? datesInScopeOf(hero, sel) : nationalHolidayDates();
const heroBridge = hero ? bridgeFor(hero, today, sel) : null;
// Without a hero (the data has run out) the block still offers the first long weekend left.
const nextBridge = hero
  ? nextLongerWeekend(today, hero, sel)
  : (getUpcomingLongWeekends(today).find((lw) => lw.span) ?? null);
---

<Layout
  title={`Festivos en ${community.name} ${year} — Calendario y próximo día libre`}
  description={`Calendario de días festivos en ${community.name}: nacionales y autonómicos, con la fecha del próximo festivo y qué se celebra.`}
  jsonLd={communityJsonLd(community.name, `/comunidad/${slug}/`, hero)}
>
  <Masthead
    subheading={`Calendario de festivos y cuenta atrás al próximo día libre en ${community.name}`}
    >Festivos en {community.name}</Masthead
  >

  <Filter value={sel} client:idle />

  {
    hero && (
      <div class="mt-4">
        <Hero
          targetDate={hero.date}
          eyebrow={hero.date === today ? "Hoy es festivo" : "Próximo festivo"}
          title={hero.localName}
          dateLine={cap(formatDate(hero.date))}
          badge={heroBadge}
          bridge={heroBridge}
          holidayDates={holidayDates}
        >
          <HeroFooterInfo holiday={hero} />
        </Hero>
      </div>
    )
  }

  <div class="mt-4 flex flex-col gap-4 lg:flex-row lg:items-stretch">
    <section class="min-w-0 rounded-xl border border-line bg-paper-card p-4 sm:p-5 lg:flex-[2]">
      <h2 class="mb-3 text-lg font-extrabold text-ink">
        {`Próximos días festivos en ${community.name} ${year}`}
      </h2>
      <HolidayListStatic
        holidays={upcoming}
        today={today}
        nextKey={nextKey}
        activeKey={activeKey}
      />
    </section>
    <div class="flex min-w-0 flex-col gap-4 lg:flex-1">
      <NextLongWeekend lw={nextBridge} holidayDates={nationalHolidayDates()} year={year} />
      <GetYourGuideCity locationId={gygLocationId(sel)} />
    </div>
  </div>

  <section class="mt-4 rounded-xl border border-line bg-paper-card p-4 sm:p-5">
    <h2 class="mb-3 text-lg font-extrabold text-ink">
      {`Calendario laboral de ${community.name} ${year}`}
    </h2>
    <Calendar
      festivos={scoped}
      activeDate={hero ? hero.date : today}
      activeKey={activeKey}
      today={today}
      client:visible
    />
  </section>

  <GetYourGuideWidget cityName={community.name} />

  {
    hero && (
      <HolidayDetails
        holiday={hero}
        comoSeViveHeading={`Cómo se vive ${hero.localName} en ${community.name}`}
        practicalHeading={`Qué tener en cuenta en ${community.name}`}
      />
    )
  }

  <PuentesTeaser today={today} />
  <Explore activeCommunity={community.code} year={year} />
  <EmbedSnippet />
  <SiteFooter year={year} />
</Layout>
