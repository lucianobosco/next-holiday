---
import Layout from "../layouts/Layout.astro";
import Masthead from "../components/Masthead.astro";
import Hero from "../components/Hero.astro";
import PuentesAdvice from "../components/PuentesAdvice.astro";
import PuentesList from "../components/PuentesList.astro";
import Filter from "../components/Filter.tsx";
import Calendar from "../components/Calendar.tsx";
import GetYourGuideCity from "../components/GetYourGuideCity.tsx";
import GetYourGuideWidget from "../components/GetYourGuideWidget.tsx";
import AdSlot from "../components/AdSlot.astro";
import Explore from "../components/Explore.astro";
import EmbedSnippet from "../components/EmbedSnippet.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getUpcomingLongWeekends } from "../lib/utils/longWeekends";
import { holidayKey, formatDate, cap } from "../lib/utils/holidays";
import { SPAIN_GYG_ID } from "../lib/utils/gygLocations";

const today = new Date().toISOString().slice(0, 10);
const year = Number(today.slice(0, 4));
const puentes = getUpcomingLongWeekends(today);
const nextPuente = puentes.find((p) => p.daysOff) ?? puentes[0];
const calFestivos = puentes.filter((p) => p.daysOff).map((p) => p.holiday);
const SITE = "https://elproximofestivo.es";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      name: `Puentes en España ${year}`,
      inLanguage: "es-ES",
      url: SITE + "/puentes",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: SITE + "/" },
        { "@type": "ListItem", position: 2, name: "Puentes", item: SITE + "/puentes" },
      ],
    },
  ],
};
---

<Layout
  title={`Puentes ${year} en España — Calendario de puentes y findes largos`}
  description={`Todos los puentes y fines de semana largos de ${year} en España: qué día pedir libre en cada festivo nacional para maximizar tus días de descanso.`}
  jsonLd={jsonLd}
>
  <Masthead
    eyebrow="Puentes y findes largos"
    subheading="Qué día pedir libre en cada festivo nacional para maximizar tus días de descanso"
    >Puentes en España {year}</Masthead
  >

  <div class="mt-6 animate-fade-up">
    <Filter
      value={null}
      disabled={true}
      note="Los puentes se calculan sobre festivos nacionales"
      client:idle
    />
  </div>

  {
    nextPuente && (
      <div class="mt-6 animate-fade-up">
        <Hero
          targetDate={nextPuente.holiday.date}
          eyebrow="Próximo puente"
          title={nextPuente.holiday.localName}
          dateLine={cap(formatDate(nextPuente.holiday.date))}
          badge={nextPuente.label}
        >
          <PuentesAdvice advice={nextPuente.advice} daysOff={nextPuente.daysOff} />
        </Hero>
      </div>
    )
  }

  <div class="mt-8 grid items-start gap-8 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="min-w-0 animate-fade-up">
      <h2 class="sr-only">Todos los puentes</h2><PuentesList today={today} year={year} />
    </div>
    <div class="min-w-0 animate-fade-up lg:sticky lg:top-20 lg:self-start">
      <h2 class="sr-only">Calendario</h2>
      <Calendar
        festivos={calFestivos}
        activeDate={nextPuente ? nextPuente.holiday.date : today}
        activeKey={nextPuente ? holidayKey(nextPuente.holiday) : null}
        today={today}
        client:visible
      />
      <GetYourGuideCity locationId={SPAIN_GYG_ID} />
      <AdSlot label="Publicidad" />
    </div>
  </div>

  <GetYourGuideWidget cityName="España" />

  <Explore isPuentes={true} year={year} />
  <EmbedSnippet />
  <SiteFooter year={year} />
</Layout>
