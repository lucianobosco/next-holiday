---
import Layout from "../layouts/Layout.astro";
import Masthead from "../components/Masthead.astro";
import Hero from "../components/Hero.astro";
import HeroFooterInfo from "../components/HeroFooterInfo.astro";
import HolidayListStatic from "../components/HolidayListStatic.astro";
import HolidayDetails from "../components/HolidayDetails.astro";
import Filter from "../components/Filter.tsx";
import Calendar from "../components/Calendar.tsx";
import GetYourGuideCity from "../components/GetYourGuideCity.tsx";
import GetYourGuideWidget from "../components/GetYourGuideWidget.tsx";
import AdSlot from "../components/AdSlot.astro";
import PuentesTeaser from "../components/PuentesTeaser.astro";
import Explore from "../components/Explore.astro";
import EmbedSnippet from "../components/EmbedSnippet.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { ALL_HOLIDAYS } from "../lib/utils/allHolidays";
import {
  getUpcomingHolidays,
  filterByScope,
  holidayKey,
  isNational,
  isLocal,
  formatDate,
  cap,
  todayInMadrid,
} from "../lib/utils/holidays";
import { getCommunityName } from "../lib/utils/communities";
import { SPAIN_GYG_ID } from "../lib/utils/gygLocations";
import { homeJsonLd } from "../lib/seo";

// Rendered on demand: "the next holiday" is worked out from the date of the request
// itself, not the date of the build. See todayInMadrid().
export const prerender = false;

const today = todayInMadrid();
const year = Number(today.slice(0, 4));
const upcoming = getUpcomingHolidays(ALL_HOLIDAYS, null, today);
// If the data ever runs out of future holidays, fall back to a 404 rather than a 500.
// Under SSG that broke the build; under SSR it would break every request.
if (!upcoming.length) return Astro.rewrite("/404");
const scoped = filterByScope(ALL_HOLIDAYS, null);
const hero = upcoming[0];
const nextKey = holidayKey(upcoming[0]);
const activeKey = holidayKey(hero);
const heroBadge = isLocal(hero)
  ? `Festivo local · ${hero.locality}`
  : isNational(hero)
    ? "Festivo nacional"
    : (hero.counties ?? []).map(getCommunityName).join(", ");
---

<Layout
  title="El Próximo Festivo en España — Cuenta atrás a tu próximo día libre"
  description="Descubre cuándo es el próximo día festivo en España —nacional, autonómico y local— con cuenta atrás en vivo y el porqué de cada celebración."
  jsonLd={homeJsonLd()}
>
  <Masthead
    eyebrow="Almanaque de festivos · España"
    subheading="Cuenta atrás para tu próximo día libre en España — nacional, autonómico y local."
    >El Próximo <span class="italic text-terracotta">Festivo</span></Masthead
  >

  <div class="mt-6 animate-fade-up"><Filter value={null} home={true} client:idle /></div>

  <div class="mt-6 animate-fade-up">
    <Hero
      targetDate={hero.date}
      eyebrow={hero.date === today ? "Hoy es festivo" : "Próximo festivo"}
      title={hero.localName}
      dateLine={cap(formatDate(hero.date))}
      badge={heroBadge}
    >
      <HeroFooterInfo holiday={hero} />
    </Hero>
  </div>

  <div class="mt-8 grid items-start gap-8 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="min-w-0 animate-fade-up">
      <h2 class="sr-only">Próximos festivos</h2><HolidayListStatic
        holidays={upcoming}
        today={today}
        nextKey={nextKey}
        activeKey={activeKey}
      />
    </div>
    <div class="min-w-0 animate-fade-up lg:sticky lg:top-20 lg:self-start">
      <h2 class="sr-only">Calendario</h2>
      <Calendar
        festivos={scoped}
        activeDate={hero.date}
        activeKey={activeKey}
        today={today}
        client:visible
      />
      <GetYourGuideCity locationId={SPAIN_GYG_ID} />
      <AdSlot label="Publicidad" />
    </div>
  </div>

  <GetYourGuideWidget cityName="España" />

  <HolidayDetails
    holiday={hero}
    comoSeViveHeading={`Cómo se vive ${hero.localName}`}
    practicalHeading={`Qué tener en cuenta: ${hero.localName}`}
  />

  <PuentesTeaser today={today} />
  <Explore year={year} />
  <EmbedSnippet />
  <SiteFooter year={year} />
</Layout>
