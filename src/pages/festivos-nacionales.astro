---
import Layout from "../layouts/Layout.astro";
import Masthead from "../components/Masthead.astro";
import Explore from "../components/Explore.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { cap, dayCount, edgeCacheSeconds, formatDate, todayInMadrid } from "../lib/utils/holidays";
import { bridgeHeadline, longWeekendOf } from "../lib/utils/longWeekends";
import {
  communitiesWithout,
  nationalFaq,
  nationalHolidaysOf,
  nationalYears,
  sharedRegionalHolidays,
} from "../lib/utils/nationalHolidays";
import { holidaySlug } from "../lib/utils/slug";
import { nationalJsonLd } from "../lib/seo";

// The page for "festivos nacionales": every national holiday of this year and the next,
// whether each one makes a long weekend, the regional holidays people mistake for national
// ones, and the questions around them. Rendered on demand so that the years roll over on
// their own, and cached at the edge like the other pages.
export const prerender = false;
Astro.cache.set({ maxAge: edgeCacheSeconds() });

const today = todayInMadrid();
const year = Number(today.slice(0, 4));
const years = nationalYears(today).map((y) => ({ year: y, holidays: nationalHolidaysOf(y) }));
const yearsLabel = years.map((y) => y.year).join(" y ");
const next = years.flatMap((y) => y.holidays).find((h) => h.date >= today) ?? null;
const nextCount = next ? dayCount(next.date, today, Date.now()) : null;
const shared = sharedRegionalHolidays(years[0]?.year ?? year);
const faq = nationalFaq(years[0]?.year ?? year);
const weekdayOf = (date: string) =>
  new Date(date + "T12:00:00Z").toLocaleDateString("es-ES", { weekday: "long", timeZone: "UTC" });
const dayMonth = (date: string) =>
  new Date(date + "T12:00:00Z").toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    timeZone: "UTC",
  });
const path = "/festivos-nacionales/";
const andList = (items: string[]) =>
  new Intl.ListFormat("es", { style: "long", type: "conjunction" }).format(items);
---

<Layout
  title={`Festivos nacionales ${yearsLabel} en España: calendario completo`}
  description={`Los festivos nacionales de España en ${yearsLabel}: qué días son, en qué día de la semana caen, cuáles dan puente y qué festivos autonómicos comparte casi todo el país.`}
  jsonLd={nationalJsonLd(path, years, faq)}
>
  <Masthead
    subheading={`Los días que son festivo en toda España en ${yearsLabel}, cuáles dan puente y cuáles parecen nacionales sin serlo.`}
    >Festivos nacionales en España {yearsLabel}</Masthead
  >

  {
    next && nextCount && (
      <p class="rounded-xl border border-line bg-paper-card p-4 text-[0.95rem] text-ink sm:p-5">
        El próximo es{" "}
        <a
          href={`/festivo/${holidaySlug(next.localName)}/`}
          class="font-bold text-accent underline-offset-4 hover:underline"
        >
          {next.localName}
        </a>
        , el {weekdayOf(next.date)} {dayMonth(next.date)}:{" "}
        <strong class="font-extrabold">
          {!nextCount.unit
            ? `es ${nextCount.num}`
            : `${nextCount.num === "1" ? "falta" : "faltan"} ${nextCount.num} ${nextCount.unit}`}
        </strong>
        .
      </p>
    )
  }

  {
    years.map(({ year: y, holidays }) => (
      <section
        class="mt-4 rounded-xl border border-line bg-paper-card p-4 sm:p-5"
        aria-labelledby={`y${y}`}
      >
        <h2 id={`y${y}`} class="text-lg font-extrabold text-ink">
          Festivos nacionales {y}
        </h2>
        <p class="mt-1 text-sm text-ink-soft">
          {holidays.length} días festivos en toda España. Pulsa uno para ver qué se celebra.
        </p>
        <table class="mt-3 w-full border-collapse text-left text-sm">
          <thead class="sr-only sm:not-sr-only">
            <tr class="border-b border-line text-xs text-ink-soft">
              <th scope="col" class="py-2 pr-3 font-bold">
                Fecha
              </th>
              <th scope="col" class="py-2 pr-3 font-bold">
                Festivo
              </th>
              <th scope="col" class="hidden py-2 font-bold sm:table-cell">
                Puente
              </th>
            </tr>
          </thead>
          <tbody>
            {holidays.map((h) => {
              const lw = longWeekendOf(h);
              const past = h.date < today;
              return (
                <tr class:list={["border-t border-line align-top", past && "text-ink-faint"]}>
                  <td class="w-[7.75rem] py-2.5 pr-3 sm:w-40">
                    <span class="block font-bold whitespace-nowrap tabular-nums">
                      {dayMonth(h.date)}
                    </span>
                    <span class="block text-xs text-ink-soft">{weekdayOf(h.date)}</span>
                  </td>
                  <td class="py-2.5 pr-3">
                    <a
                      href={`/festivo/${holidaySlug(h.localName)}/`}
                      class:list={[
                        "font-bold underline-offset-4 hover:underline",
                        past ? "text-ink-faint" : "text-ink",
                      ]}
                    >
                      {h.localName}
                    </a>
                    <span class="mt-0.5 block text-xs text-ink-soft sm:hidden">
                      {bridgeHeadline(lw)}
                    </span>
                  </td>
                  <td class="hidden py-2.5 text-ink-soft sm:table-cell">{bridgeHeadline(lw)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>
    ))
  }

  {
    shared.length > 0 && (
      <section
        class="mt-4 rounded-xl border border-line bg-paper-card p-4 sm:p-5"
        aria-labelledby="shared"
      >
        <h2 id="shared" class="text-lg font-extrabold text-ink">
          Parecen nacionales, pero son autonómicos
        </h2>
        <p class="mt-1 text-sm text-ink-soft">
          Festivos de {years[0].year} que tienen varias comunidades a la vez, pero no toda España.
        </p>
        <ul class="mt-3">
          {shared.map((s) => {
            const without = communitiesWithout(s);
            const where =
              without.length < s.communities.length
                ? `En todas las comunidades menos ${andList(without)}.`
                : `En ${andList(s.communities)}.`;
            return (
              <li class="border-t border-line py-2.5 text-sm">
                <span class="font-bold text-ink">{s.holiday.localName}</span>
                <span class="text-ink-soft"> · {cap(formatDate(s.holiday.date))}</span>
                <span class="mt-0.5 block text-ink-soft">{where}</span>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  <section
    class="mt-4 rounded-xl border border-line bg-paper-card p-4 sm:p-5"
    aria-labelledby="faq"
  >
    <h2 id="faq" class="text-lg font-extrabold text-ink">Preguntas frecuentes</h2>
    <div class="mt-2">
      {
        faq.map((f) => (
          <div class="border-t border-line py-3">
            <h3 class="text-[0.95rem] font-bold text-ink">{f.q}</h3>
            <p class="mt-1 max-w-[70ch] text-sm leading-relaxed text-ink-soft">{f.a}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-2 text-sm text-ink-soft">
      Para ver los festivos de tu comunidad o tu ciudad, elige una abajo, o mira{" "}
      <a href="/puentes/" class="font-semibold text-accent underline underline-offset-4"
        >todos los puentes de {year}</a
      >.
    </p>
  </section>

  <Explore year={year} isNational={true} />
  <SiteFooter year={year} />
</Layout>
