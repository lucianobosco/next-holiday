---
import Layout from "../../layouts/Layout.astro";
import Masthead from "../../components/Masthead.astro";
import Hero from "../../components/Hero.astro";
import HeroFooterInfo from "../../components/HeroFooterInfo.astro";
import HolidayListStatic from "../../components/HolidayListStatic.astro";
import HolidayDetails from "../../components/HolidayDetails.astro";
import Filter from "../../components/Filter.tsx";
import Calendar from "../../components/Calendar.tsx";
import GetYourGuideCity from "../../components/GetYourGuideCity.tsx";
import GetYourGuideWidget from "../../components/GetYourGuideWidget.tsx";
import NextLongWeekend from "../../components/NextLongWeekend.astro";
import PuentesTeaser from "../../components/PuentesTeaser.astro";
import Explore from "../../components/Explore.astro";
import EmbedSnippet from "../../components/EmbedSnippet.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getHolidayBySlug } from "../../lib/utils/slug";
import { ALL_HOLIDAYS, nextOccurrence } from "../../lib/utils/allHolidays";
import {
  getUpcomingHolidays,
  filterByScope,
  holidayKey,
  isNational,
  isLocal,
  formatDate,
  cap,
  todayInMadrid,
  edgeCacheSeconds,
} from "../../lib/utils/holidays";
import { getCommunityName } from "../../lib/utils/communities";
import { getHolidayInfo } from "../../lib/utils/holidayInfo";
import { SPAIN_GYG_ID } from "../../lib/utils/gygLocations";
import { holidayJsonLd } from "../../lib/seo";
import {
  datesInScopeOf,
  heroBridge as bridgeFor,
  nationalHolidayDates,
  nextLongerWeekend,
} from "../../lib/utils/longWeekends";

// Rendered on demand: the next occurrence of the holiday, and its countdown, are worked
// out from the date of the request.
export const prerender = false;

const { slug } = Astro.params;
const meta = getHolidayBySlug(slug!);
if (!meta) return Astro.rewrite("/404");
const today = todayInMadrid();
const year = Number(today.slice(0, 4));
Astro.cache.set({ maxAge: edgeCacheSeconds() });
const hero =
  nextOccurrence(meta.name, today) ?? ALL_HOLIDAYS.find((h) => h.counties === null && !h.locality)!;
const upcoming = getUpcomingHolidays(ALL_HOLIDAYS, null, today);
const scoped = filterByScope(ALL_HOLIDAYS, null);
const nextKey = upcoming.length ? holidayKey(upcoming[0]) : null;
const activeKey = holidayKey(hero);
// The year of the occurrence being described, NOT the current one. From August most of
// these resolve to next year, and 21 of the 32 pages were titled with this year over a
// date in the next -- on exactly the "cuándo es X" queries the pages exist to answer.
const heroYear = hero.date.slice(0, 4);
const isNext = activeKey === nextKey;
const heroBadge = isLocal(hero)
  ? `Festivo local · ${hero.locality}`
  : isNational(hero)
    ? "Festivo nacional"
    : (hero.counties ?? []).map(getCommunityName).join(", ");
const info = getHolidayInfo(hero);
// The holidays of the hero's own scope: what makes its long weekend real.
const holidayDates = hero ? datesInScopeOf(hero) : nationalHolidayDates();
const heroBridge = bridgeFor(hero, today);
const nextBridge = nextLongerWeekend(today, hero);
---

<Layout
  title={`${meta.name} ${heroYear}: cuándo es y qué se celebra`}
  description={`${
    info?.description ?? `Cuándo es ${meta.name} y qué se conmemora.`
  } Próximo ${meta.name}: ${cap(formatDate(hero.date))}.`}
  jsonLd={holidayJsonLd(meta, today, `/festivo/${slug}/`)}
>
  <Masthead subheading="cuándo es y qué se celebra">{`${meta.name} ${heroYear}`}</Masthead>

  <Filter value={null} client:idle />

  <div class="mt-4">
    <Hero
      targetDate={hero.date}
      eyebrow={hero.date === today
        ? "Hoy se celebra"
        : isNext
          ? "Próximo festivo"
          : "Festivo seleccionado"}
      title={hero.localName}
      dateLine={cap(formatDate(hero.date))}
      badge={heroBadge}
      bridge={heroBridge}
      holidayDates={holidayDates}
    >
      <HeroFooterInfo holiday={hero} />
    </Hero>
  </div>

  <div class="mt-4 flex flex-col gap-4 lg:flex-row lg:items-stretch">
    <section class="min-w-0 rounded-xl border border-line bg-paper-card p-4 sm:p-5 lg:flex-[2]">
      <h2 class="mb-3 text-lg font-extrabold text-ink">Otros festivos próximos en España</h2>
      {
        /* Capped at 5. All 32 of these pages were rendering the same 15-card national
           list, byte-identical between them. Measured: this takes two holiday pages from
           90.1% to 86.7% identical and 154 KB to 142 KB each. It is an improvement, not a
           cure -- what is left is the site chrome (Explore's 71 place links, the footer,
           the embed snippet, the calendar), and those links are the only crawlable path to
           the 71 /comunidad/ URLs, so they stay. */
      }
      <HolidayListStatic
        holidays={upcoming}
        today={today}
        nextKey={nextKey}
        activeKey={activeKey}
        limit={5}
        max={5}
      />
    </section>
    <div class="flex min-w-0 flex-col gap-4 lg:flex-1">
      <NextLongWeekend lw={nextBridge} holidayDates={nationalHolidayDates()} year={year} />
      <GetYourGuideCity locationId={SPAIN_GYG_ID} />
    </div>
  </div>

  <section class="mt-4 rounded-xl border border-line bg-paper-card p-4 sm:p-5">
    <h2 class="mb-3 text-lg font-extrabold text-ink">Calendario laboral de España {year}</h2>
    <Calendar
      festivos={scoped}
      activeDate={hero.date}
      activeKey={activeKey}
      today={today}
      client:visible
    />
  </section>

  <GetYourGuideWidget cityName="España" />

  <HolidayDetails
    holiday={hero}
    comoSeViveHeading={`Cómo se celebra ${meta.name} en España`}
    practicalHeading={`Qué abre y qué cierra: ${meta.name}`}
  />

  <PuentesTeaser today={today} />
  <Explore year={year} />
  <EmbedSnippet />
  <SiteFooter year={year} />
</Layout>
