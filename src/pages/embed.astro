---
import "../styles/global.css";
import Countdown from "../components/Countdown.tsx";
import { ALL_HOLIDAYS } from "../lib/utils/allHolidays";
import {
  getUpcomingHolidays,
  formatDate,
  todayInMadrid,
  edgeCacheSeconds,
} from "../lib/utils/holidays";

// Rendered on demand, like the home page. Prerendered, it froze at the build's date: the
// widget other sites embed kept counting towards a holiday that had already passed, and
// "the next holiday" was worked out in UTC. Cached at the edge until midnight in Madrid.
export const prerender = false;
Astro.cache.set({ maxAge: edgeCacheSeconds() });

const today = todayInMadrid();
const hero = getUpcomingHolidays(ALL_HOLIDAYS, null, today)[0] ?? null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Próximo festivo en España</title>
    <meta name="robots" content="noindex" />
    <link rel="preload" href="/fonts/public-sans.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="overflow-auto bg-transparent!">
    <a
      href="https://elproximofestivo.es/"
      target="_blank"
      rel="noopener"
      class="relative box-border block min-h-dvh rounded-xl border border-line bg-paper-card p-4 text-ink no-underline"
    >
      <span class="text-xs font-bold text-ink-soft">Próximo festivo en España</span>
      {
        hero ? (
          <>
            <h1 class="mt-0.5 truncate text-lg font-extrabold leading-tight text-ink">
              {hero.localName}
            </h1>
            <p class="text-sm text-ink-soft">{formatDate(hero.date)}</p>
            {/* The site's countdown is sized for the home page's hero; in a 200px-high
                iframe its number is brought down so the whole card fits without scrolling. */}
            <div class="mt-2 [&_p_span:first-child]:text-5xl">
              <Countdown targetDate={hero.date} serverNow={Date.now()} client:load />
            </div>
          </>
        ) : (
          <h1 class="mt-0.5 text-lg font-extrabold leading-tight text-ink">
            Consulta el calendario de festivos
          </h1>
        )
      }
      <span class="absolute bottom-3 right-4 text-xs text-ink-faint">elproximofestivo.es</span>
    </a>
  </body>
</html>
