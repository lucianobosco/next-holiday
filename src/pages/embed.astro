---
import "../styles/global.css";
import Countdown from "../components/Countdown.tsx";
import { ALL_HOLIDAYS } from "../lib/utils/allHolidays";
import {
  getUpcomingHolidays,
  formatDate,
  todayInMadrid,
  edgeCacheSeconds,
} from "../lib/utils/holidays";

// Rendered on demand, like the home page. Prerendered, it froze at the build's date: the
// widget other sites embed kept counting towards a holiday that had already passed, and
// "the next holiday" was worked out in UTC. Cached at the edge until midnight in Madrid.
export const prerender = false;
Astro.cache.set({ maxAge: edgeCacheSeconds() });

const today = todayInMadrid();
const hero = getUpcomingHolidays(ALL_HOLIDAYS, null, today)[0] ?? null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Próximo festivo en España</title>
    <meta name="robots" content="noindex" />
    <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-gradient-to-br from-terracotta via-[#b33f24] to-[#8f2f1a]">
    <a
      href="https://elproximofestivo.es/"
      target="_blank"
      rel="noopener"
      class="block p-5 no-underline"
    >
      <span class="text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-cream/70"
        >Próximo festivo en España</span
      >
      {
        hero ? (
          <>
            <h1 class="font-display mt-1 text-2xl font-semibold leading-tight text-cream">
              {hero.localName}
            </h1>
            <p class="mt-0.5 text-sm text-cream/85">{formatDate(hero.date)}</p>
            <div class="mt-3 max-w-[160px]">
              <Countdown targetDate={hero.date} serverNow={Date.now()} client:load />
            </div>
          </>
        ) : (
          <h1 class="font-display mt-1 text-2xl font-semibold leading-tight text-cream">
            Consulta el calendario de festivos
          </h1>
        )
      }
      <p class="mt-3 text-[0.6rem] text-cream/60">elproximofestivo.es</p>
    </a>
  </body>
</html>
