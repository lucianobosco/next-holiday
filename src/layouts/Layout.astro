---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import CookieConsentBanner from "../components/CookieConsentBanner.tsx";
import Feedback from "../components/Feedback.tsx";
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  jsonLd?: object;
}
const { title, description = "", canonical, jsonLd } = Astro.props;
// With SSR both shapes answer 200, with and without the trailing slash. The canonical is
// normalised to the one with it -- the shape the sitemap emits -- so that search engines
// are not handed the same page twice.
const path = Astro.url.pathname;
const canonicalPath = path.endsWith("/") ? path : `${path}/`;
const canonicalUrl = canonical ?? new URL(canonicalPath, Astro.site).href;
const ogImage = new URL("/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f3f4f6" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="El Próximo Festivo" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="El Próximo Festivo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="El Próximo Festivo" href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="dns-prefetch" href="https://widget.getyourguide.com" />
    <link rel="dns-prefetch" href="https://cdn.getyourguide.com" />
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
    <link rel="preload" href="/fonts/public-sans.woff2" as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "e0fd40795b854657a77102acc4216fdf"}'></script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2.5 focus:text-sm focus:font-bold focus:text-white"
      >Saltar al contenido</a
    >
    <SiteHeader />
    <main id="main" class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
      <slot />
    </main>
    <CookieConsentBanner client:idle />
    <Feedback client:idle />
    <script>
      // GetYourGuide's partner script scans the DOM once and mounts an iframe into every
      // div[data-gyg-widget]. The divs are static HTML -- the components never hydrate -- so
      // that Preact's reconciliation cannot wipe the iframe.
      //
      // Deferred on purpose: the widgets live below the fold, and loading third-party JS on
      // first paint costs TBT and LCP. An IntersectionObserver waits until a widget comes
      // near the viewport and only then is the script injected.
      const widgets = document.querySelectorAll("[data-gyg-widget]");
      if (widgets.length) {
        const io = new IntersectionObserver(
          (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            io.disconnect();
            const s = document.createElement("script");
            s.async = true;
            s.src = "https://widget.getyourguide.com/dist/pa.umd.production.min.js";
            s.setAttribute("data-gyg-partner-id", "PNCUJCI");
            // The widgets reserve their height so that nothing jumps when they arrive. If the
            // script is blocked or never fills them, that reservation would stay as a blank
            // hole the size of a screen: give it up and hide the empty boxes instead.
            const release = () =>
              widgets.forEach((el) => {
                if (el.querySelector("iframe")) return;
                const box = el.closest("section");
                if (box) box.hidden = true;
              });
            s.onerror = release;
            setTimeout(release, 10000);
            document.head.appendChild(s);
          },
          { rootMargin: "400px" },
        );
        widgets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
