{
  "name": "next-holiday",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev -c dist/server/wrangler.json",
    "deploy": "astro build && wrangler deploy -c dist/server/wrangler.json",
    "check": "npm run format && npm run lint && npm run typecheck && npm run coverage",
    "fetch-holidays": "tsx scripts/fetch-holidays.ts",
    "fetch-holiday-info": "tsx scripts/fetch-holiday-info.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "leaks": "tools/check-leaks.sh"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "preact": "^10.29.7",
    "tailwindcss": "^4.3.2",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.1.3",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.111.0"
  },
  "license": "MIT",
  "description": "Spain's next public holiday, by region and city — and the long weekends it makes.",
  "homepage": "https://elproximofestivo.es",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucianobosco/next-holiday.git"
  }
}
